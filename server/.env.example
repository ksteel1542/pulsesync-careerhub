# Copy to server/.env and fill in. Never commit real values (.env is gitignored).

# --- Server ---
PORT=4000
# Bind address. 127.0.0.1 for local dev; 0.0.0.0 when deploying behind a proxy.
HOST=127.0.0.1
# Where Stripe/Paystack send the user back after checkout.
CLIENT_URL=http://localhost:5173
# Default provider when the client doesn't specify one: stripe | paystack
PAYMENT_PROVIDER=stripe

# --- Stripe ---  (dashboard.stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Paystack ---  (dashboard.paystack.com → Settings → API Keys & Webhooks)
# Paystack signs webhooks with the secret key itself (no separate webhook secret).
PAYSTACK_SECRET_KEY=
# Paystack subscriptions need a Plan created in the dashboard; paste each plan code here.
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_ENTERPRISE=
